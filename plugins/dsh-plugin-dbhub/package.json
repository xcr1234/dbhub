{
  "name": "@xcr1234/dsh-plugin-dbhub",
  "version": "0.1.0",
  "description": "DSH plugin: manage dbhub database MCP servers from the settings panel; starts dbhub in-process (no npx) and exposes its tools via dsh-mcp-client.",
  "type": "module",
  "license": "MIT",
  "author": "xcr1234",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xcr1234/dbhub.git",
    "directory": "plugins/dsh-plugin-dbhub"
  },
  "bugs": {
    "url": "https://github.com/xcr1234/dbhub/issues"
  },
  "homepage": "https://github.com/xcr1234/dbhub/tree/main/plugins/dsh-plugin-dbhub#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "dbhub",
    "database",
    "postgres",
    "mysql",
    "sqlite"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./typert": {
      "types": "./lib/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./client": "./client/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/build-client.mjs",
    "build:host": "tsup",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tests/runner.mjs",
    "format": "biome format --write src tests",
    "lint": "biome check src tests",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.0.0",
    "@iarna/toml": "^2.2.5",
    "@xcr1234/dbhub-fork": "workspace:^1.10.0"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "zod": "^4.0.0"
  }
}
